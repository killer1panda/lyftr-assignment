# Comma-separated key pool (>= 2 keys). Ids become key_1, key_2, ... in this order.
# Get free Gemini keys (use different Google projects/accounts) at https://aistudio.google.com/apikey
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2

# Any LiteLLM model name that matches your keys
LLM_MODEL=gemini/gemini-2.5-flash

# SQLite file; keep it under the /data docker volume
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins (the frontend URL(s))
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure request header
ENABLE_FAILURE_SIMULATION=true

# Optional (CACHE_TYPE: local = in-memory, disk = persists under CACHE_DIR)
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_TYPE=local
CACHE_DIR=/data/llm_cache
LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=50

# Frontend build-time: public URL of the backend
VITE_API_BASE_URL=http://localhost:8000
